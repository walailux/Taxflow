# ---------- API (apps/api) ----------
PORT=4000

# ฐานข้อมูล: ไม่ตั้ง = ใช้ SQLite ในเครื่อง (data/taxflow.db)
# ตั้งแล้ว = ใช้ PostgreSQL 16 ผ่าน lib/store.pg.js  <-- เป้าหมาย WP3 (Supabase)
# ใช้ Session pooler ของ Supabase (รองรับ IPv4) ไม่ใช่ Direct connection ที่เป็น IPv6 อย่างเดียว
# สังเกตว่าชื่อผู้ใช้ต้องมี project ref ต่อท้ายด้วยจุด และโฮสต์ลงท้าย .com
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# ถ้ารหัสผ่านมีอักขระพิเศษ (% @ : / ? #) ที่ทำให้ URL เพี้ยน ให้แยกรหัสออกมาไว้บรรทัดนี้แทน
# แล้วตัดส่วน ":รหัสผ่าน" ออกจาก DATABASE_URL ข้างบน วิธีนี้รหัสไม่ต้องผ่านการแกะ URL
# PGPASSWORD=

# โดเมนหน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วยจุลภาค) ใช้กับ CORS และการกัน CSRF
WEB_ORIGINS=http://localhost:5173,http://localhost:4000


# เข้าสู่ระบบ / สมัครด้วย Google: Client ID แบบ Web application จาก Google Cloud Console
# ไม่ตั้ง = ไม่แสดงปุ่ม Google (ดูวิธีสร้างที่ infra/README.md หัวข้อ 12)
GOOGLE_CLIENT_ID=

# ใช้คุกกี้ข้ามโดเมน (SameSite=None; Secure) เมื่อหน้าเว็บกับ API คนละโดเมน
# COOKIE_CROSS_SITE=1
# ทางสำรองถ้าเบราว์เซอร์บล็อกคุกกี้ข้ามโดเมนตอนทดสอบ: ใช้ Authorization: Bearer แทน
# AUTH_HEADER_MODE=1

# URL สาธารณะสำหรับสร้างลิงก์ตรวจสอบเอกสารใน QR Code
PUBLIC_BASE_URL=http://localhost:5173

# แสดงรหัส OTP กลับมาใน response ตอนพัฒนา (อย่าเปิดบนเครื่องจริง)
# TAXFLOW_DEV=1

# ---------- ยังไม่ใช้ เตรียมไว้สำหรับชุดงานถัดไป ----------
# WP4 Supabase Storage (S3 API)
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_PRIVATE=taxflow-private
# S3_BUCKET_PUBLIC=taxflow-public

# WP6 ลายมือชื่อดิจิทัล (PAdES) ด้วยใบรับรองที่ออกเอง
# สร้างใบรับรองด้วย  npm run sign:setup  แล้วนำรหัสผ่านที่แสดงบนจอมาใส่บรรทัดนี้
# ไม่ตั้งค่า = ระบบยังออก PDF/A-3 ได้ตามปกติ แต่ไม่มีลายมือชื่อดิจิทัลในไฟล์
# SIGN_KEY_PASSPHRASE=
# บนคลาวด์ (WP7) ไม่มีดิสก์ถาวร ใช้ base64 ของไฟล์ pem แทนไฟล์ใน data/sign/
# SIGN_KEY_PEM_B64=
# SIGN_CERT_PEM_B64=
